# Pinned cloudflared dependency for rabbit-hole.
#
# Consumed by:
#   - install.sh / install.ps1  (PINNED version + per-platform SHA256)
#   - src/services/cloudflared.rs tests  (MIN must match the MIN const)
#
# MIN is the oldest supported release. The `--no-prechecks` flag is TUN-10387,
# first shipped in 2026.5.0.
#
# PINNED is the version the release installers fetch. It must be >= MIN.
#
# Bump procedure:
#   1. Update PINNED.
#   2. Refresh the SHA256 values below.
#      - Raw assets: hash the downloaded file.
#      - macOS .tgz: hash the extracted `cloudflared` binary, not the archive.
#   3. Keep MIN unless adopting a newer required feature or flag.
#   4. Run `cargo test pin_`.
#
# Upstream release:
# https://github.com/cloudflare/cloudflared/releases/tag/2026.9.1
MIN=2026.5.0
PINNED=2026.9.1

# SHA256 values.
cloudflared-linux-amd64 03f1f25d1cc93b9ad6c60569d44060bc4f17ed97075760ed8cfca4b12dcd68cc
cloudflared-linux-arm64 3d97437c71848bd8df68041e12436b484a661d95073ea1937f01a845ce88faa3
cloudflared-darwin-amd64.tgz 1ea07ae775b03236bd6be18ca1848d6bdc4af2f4f3bce398823b5a36e5761b75
cloudflared-darwin-arm64.tgz 9a0b19f67dc7a3011bc6b972c7ce06a5fcea8784ac6bd599ffa382ea4aeb5a6e
cloudflared-windows-amd64.exe 2837888cc0f5d58f15b6dc478376de90b4d3ba5241c7947455d1e0a0df429712
